#!/bin/sh
# Pre-commit de DeckForge: corre `pnpm run check` (tipos, lint, formato y
# tests contra el catalogo real) y rechaza el commit si algo falla.
#
# Lo activa `pnpm install` con el script `prepare`, que apunta
# core.hooksPath a esta carpeta. Sin dependencias: es un script de shell.
#
# Mira el arbol de trabajo, no solo lo que esta en el stage: un archivo a
# medio agregar se revisa como esta en disco. Para saltarlo en una urgencia,
# `git commit --no-verify`, y correr `pnpm run check` despues.

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: no encuentro pnpm. Instalalo o salta el hook con --no-verify." >&2
  exit 1
fi

if ! pnpm run check; then
  echo "" >&2
  echo "pre-commit: pnpm run check fallo, el commit no se hizo." >&2
  echo "Si es solo formato, 'pnpm run format' lo arregla." >&2
  exit 1
fi
