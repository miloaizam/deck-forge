# Cabeceras de seguridad. Cloudflare Pages lee este archivo desde la raiz
# del sitio publicado. Ver "Seguridad" en CLAUDE.md.
#
# Esto es una PLANTILLA. `pnpm run build` corre scripts/csp-hashes.mjs, que
# cambia el 'unsafe-inline' de script-src por los hashes de los <script>
# inline de cada pagina y agrega una regla por pagina en out/_headers. El
# 'unsafe-inline' de aqui es solo el punto de partida: si el paso de hashes
# no corre, `pnpm run audit` falla.
#
# style-src si conserva 'unsafe-inline': React escribe atributos style="…"
# y esos no se pueden autorizar por hash sin 'unsafe-hashes' atributo por
# atributo. Un estilo inyectado no ejecuta codigo.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Los assets con hash en el nombre son inmutables.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# El catalogo cambia cuando publicamos cartas nuevas: revalidar siempre.
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Las imagenes de carta llevan el codigo en el nombre y no se reescriben.
/cards/*
  Cache-Control: public, max-age=604800

# Los documentos llevan la fecha en el nombre (FeDeErratas-AAMMDD.pdf): una
# version nueva es un archivo nuevo. Un dia de cache basta igual.
/reglas/*
  Cache-Control: public, max-age=86400
