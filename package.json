{
  "name": "deckforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "description": "Constructor de barajas para el formato Escuelas Elementales de Mitos y Leyendas",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp-hashes.mjs",
    "preview": "python3 -m http.server --directory out 4173",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./scripts/ts-imports.mjs --test src/lib/*.test.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "prepare": "node scripts/install-hooks.mjs",
    "audit": ".venv/bin/python scripts/audit_build.py",
    "e2e": "playwright test --grep-invert @a11y",
    "a11y": "playwright test --grep @a11y",
    "data:fetch": ".venv/bin/python scripts/fetch_edition.py",
    "data:card": ".venv/bin/python scripts/fetch_card.py",
    "data:cards": ".venv/bin/python scripts/build_cards.py",
    "data:images": ".venv/bin/python scripts/convert_images.py",
    "e2e:nube": "NEXT_PUBLIC_SUPABASE_URL=https://prueba.supabase.co NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_prueba pnpm run build && E2E_NUBE=1 playwright test e2e/nube.spec.ts"
  },
  "dependencies": {
    "@supabase/auth-js": "2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "lz-string": "^1.5.0",
    "minisearch": "^7.2.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
